{
  "name": "naseeb-odds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "report": "vite-node scripts/report.ts",
    "log:deploy": "npx wrangler@4 deploy --config worker/wrangler.toml",
    "log:schema": "npx wrangler@4 d1 execute naseeb-odds-searches --remote --config worker/wrangler.toml --file worker/schema.sql",
    "log:stats": "node scripts/search-stats.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
